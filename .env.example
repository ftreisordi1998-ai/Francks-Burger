# Copie para .env.local e preencha. Nunca commite o .env.local.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ-anon-key-ficticia
# Somente servidor. Usada pelo webhook do Mercado Pago e pela conciliação,
# que recebem eventos sem sessão de usuário. Ignora RLS: trate como senha.
SUPABASE_SERVICE_ROLE_KEY=eyJ-service-role-ficticia

# --- Mercado Pago -----------------------------------------------------------
# Liga/desliga o pagamento online no checkout. Com "false" o site segue no
# fluxo antigo (chave Pix + comprovante). Troque só depois de validar.
NEXT_PUBLIC_PAYMENTS_ONLINE_ENABLED=false
# Public Key (frontend, Bricks). Teste: TEST-...  Produção: APP_USR-...
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
# Access Token (somente servidor). O prefixo define o ambiente esperado:
# TEST- = sandbox, APP_USR- = produção. Pagamento com live_mode diferente do
# esperado é marcado para resolução, nunca confirmado.
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
# Assinatura secreta do webhook (Suas integrações > Webhooks > Configurar).
MERCADOPAGO_WEBHOOK_SECRET=segredo-ficticio
# URL pública do webhook. Se vazio, deriva de NEXT_PUBLIC_SITE_URL.
MERCADOPAGO_WEBHOOK_URL=https://francksburger.com.br/api/payments/mercadopago/webhook
# Vencimento do Pix em minutos. A API exige mínimo 30 e máximo 43200 (30 dias);
# valores fora disso são corrigidos para o limite.
MERCADOPAGO_PIX_EXPIRATION_MINUTES=30

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://francksburger.com.br
# Segredo que o pg_cron envia (Authorization: Bearer ...) para a rota de
# conciliação. Gere algo longo e aleatório.
PAYMENTS_RECONCILE_SECRET=troque-por-um-segredo-longo

# --- Já existentes no projeto ------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_MAPBOX_TOKEN=
